APP_NAME=Bookflix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Days the security log (failed sign-ins, lockouts, 429s, 403s) is kept.
LOG_SECURITY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bookflix
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Hosted Neon: pooled connection string (app traffic).
# DB_URL=
# Hosted Neon: direct (non-pooled) connection string, for migrations.
# DB_DIRECT_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie is Secure by default when APP_ENV=production. `true` or `false`; leave it unset for that default (an empty value counts as false).
# SESSION_SECURE_COOKIE=true
# Proxies whose X-Forwarded-* headers are believed: `*` on Vercel only (its proxy is the only way in), or a comma list of addresses or CIDR ranges. Unset trusts none.
# TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TOKEN=change-me
ML_SERVICE_TIMEOUT=5
ML_SERVICE_CONNECT_TIMEOUT=1

BOOKFLIX_PROVIDER_USER_AGENT="Bookflix/0.1 (+https://github.com/NightServant/bookflix)"
BOOKFLIX_OPENLIBRARY_ENABLED=false
BOOKFLIX_ANILIST_ENABLED=false
BOOKFLIX_MANGADEX_ENABLED=false
BOOKFLIX_MANGAUPDATES_ENABLED=false
BOOKFLIX_COMICVINE_ENABLED=false
BOOKFLIX_METRON_ENABLED=false
BOOKFLIX_HARDCOVER_ENABLED=false
BOOKFLIX_WIKIDATA_ENABLED=false
BOOKFLIX_WIKIPEDIA_ENABLED=false

# Catalog expansion wave 1 (keys stay in .env only). MangaDex, MangaUpdates and Wikidata need no key.
BOOKFLIX_COMICVINE_API_KEY=
BOOKFLIX_METRON_USERNAME=
BOOKFLIX_METRON_PASSWORD=
BOOKFLIX_HARDCOVER_API_TOKEN=
BOOKFLIX_GOOGLE_BOOKS_API_KEY=
BOOKFLIX_NYT_BOOKS_API_KEY=

SCOUT_DRIVER=database
SCOUT_QUEUE=false

# Bookflix AI: an open-source model behind a hosted OpenAI-compatible API. Off until enabled and all of these are set (keys stay in .env only).
BOOKFLIX_AI_ENABLED=false
BOOKFLIX_AI_BASE_URL=
BOOKFLIX_AI_API_KEY=
BOOKFLIX_AI_MODEL_FAST=
BOOKFLIX_AI_MODEL_SMART=
BOOKFLIX_AI_MODEL_VISION=
